{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dvdknaap/download_js_map_files/schemas/artifact-manifest.schema.json",
  "title": "download_js_map_files artifact_manifest.json",
  "type": "object",
  "required": ["schema_version", "generated_by", "artifact_count", "artifacts"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_by": {
      "type": "string",
      "const": "download_js_map_files"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
