{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dvdknaap/download_js_map_files/schemas/secret-finding-record.schema.json",
  "title": "download_js_map_files findings.jsonl record",
  "type": "object",
  "required": ["type", "pattern", "confidence", "label", "path", "line_number", "line_excerpt"],
  "properties": {
    "type": {
      "type": "string",
      "const": "secret"
    },
    "pattern": {"type": "string"},
    "confidence": {"type": "string"},
    "label": {"type": "string"},
    "path": {"type": "string"},
    "line_number": {
      "type": "integer",
      "minimum": 1
    },
    "line_excerpt": {"type": "string"}
  },
  "additionalProperties": false
}
